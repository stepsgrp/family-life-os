{
  "name": "family-life-os",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\"",
    "db:generate": "pnpm --filter @flos/db generate",
    "db:migrate": "pnpm --filter @flos/db migrate",
    "db:seed": "pnpm --filter @flos/db seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "postinstall": "pnpm --filter @flos/db generate",
    "test:integration": "pnpm --filter @flos/api test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.2",
    "turbo": "^2.11.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
