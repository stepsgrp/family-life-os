# ---------- Shared ----------
DATABASE_URL=postgresql://flos:flos@localhost:5432/flos
REDIS_URL=redis://localhost:6379

# ---------- Clerk (auth + Organizations = Family) ----------
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# ---------- API ----------
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ANTHROPIC_API_KEY=sk-ant-xxx
GOOGLE_PLACES_API_KEY=xxx
RESEND_API_KEY=re_xxx
EMAIL_FROM="Family Life OS <noreply@yourdomain.com>"

# Supabase Realtime (broadcast only - Postgres lives wherever DATABASE_URL points)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=flos-documents

# Billing
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_xxx
REVENUECAT_WEBHOOK_AUTH=some-long-random-string

# Observability
SENTRY_DSN=
BETTERSTACK_HEARTBEAT_URL=

# ---------- Web (Next.js) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Mobile (Expo) ----------
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=xxx
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
