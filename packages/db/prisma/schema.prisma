// Family Life OS - data model
//
// Tenancy rule: every domain row carries familyId. The API never trusts a familyId
// sent by the client; it always uses ctx.familyId resolved from the authenticated member.
//
// Role model (FamilyRole):
//   ADMIN_PARENT - owns billing, can remove members and delete the family
//   PARENT       - full read/write on all family data
//   TEEN         - read everything, write own chores/grocery/calendar, no documents/billing
//   CHILD        - read own chores + calendar, mark own chores complete

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL lives in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

enum FamilyRole {
  ADMIN_PARENT
  PARENT
  TEEN
  CHILD
}

enum PlanTier {
  FREE
  FAMILY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingSource {
  STRIPE
  APP_STORE
  PLAY_STORE
}

enum ReminderKind {
  SCHOOL
  MEDICINE
  GENERAL
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

enum ChoreRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum AppointmentStatus {
  DRAFT
  APPROVED
  SENT
  CONFIRMED
  CANCELED
}

model Family {
  id         String   @id @default(cuid())
  clerkOrgId String   @unique
  name       String
  timezone   String   @default("America/New_York")
  homeLat    Float?
  homeLng    Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members           FamilyMember[]
  invites           FamilyInvite[]
  events            CalendarEvent[]
  groceryItems      GroceryItem[]
  recipes           Recipe[]
  mealPlans         MealPlanEntry[]
  chores            Chore[]
  reminders         Reminder[]
  documents         Document[]
  emergencyContacts EmergencyContact[]
  vacations         Vacation[]
  appointments      AppointmentRequest[]
  subscription      Subscription?
  aiUsage           AiUsage[]
}

model FamilyMember {
  id                  String     @id @default(cuid())
  familyId            String
  clerkUserId         String? // null for young children without a login
  displayName         String
  role                FamilyRole
  color               String     @default("#6366F1") // calendar color-coding
  birthDate           DateTime?
  interests           String[]
  dietaryRestrictions String[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  family         Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  pushTokens     PushToken[]
  assignedChores Chore[]         @relation("ChoreAssignee")
  eventLinks     EventAttendee[]
  reminders      Reminder[]

  @@unique([familyId, clerkUserId])
  @@index([clerkUserId])
}

model FamilyInvite {
  id        String     @id @default(cuid())
  familyId  String
  token     String     @unique
  role      FamilyRole
  email     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model PushToken {
  id        String   @id @default(cuid())
  memberId  String
  token     String   @unique // ExponentPushToken[...]
  platform  String // ios | android
  createdAt DateTime @default(now())

  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id            String   @id @default(cuid())
  familyId      String
  title         String
  description   String?
  location      String?
  startsAt      DateTime
  endsAt        DateTime
  allDay        Boolean  @default(false)
  googleEventId String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  family    Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  attendees EventAttendee[]

  @@index([familyId, startsAt])
}

model EventAttendee {
  eventId  String
  memberId String

  event  CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member FamilyMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([eventId, memberId])
}

model GroceryItem {
  id           String   @id @default(cuid())
  familyId     String
  name         String
  quantity     String?
  category     String   @default("other") // produce, dairy, meat, bakery, pantry, frozen, household, other
  checked      Boolean  @default(false)
  addedById    String?
  sourceMealId String? // set when generated from a meal plan
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, checked])
}

model Recipe {
  id              String   @id @default(cuid())
  familyId        String
  name            String
  prepTimeMinutes Int?
  ingredients     Json // [{ name, quantity, category }]
  instructions    String?
  tags            String[]
  createdAt       DateTime @default(now())

  family   Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  mealPlan MealPlanEntry[]

  @@index([familyId])
}

model MealPlanEntry {
  id        String   @id @default(cuid())
  familyId  String
  date      DateTime @db.Date
  slot      MealSlot
  recipeId  String?
  title     String // free-text fallback when there is no recipe
  createdAt DateTime @default(now())

  family Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@unique([familyId, date, slot])
  @@index([familyId, date])
}

model Chore {
  id                String          @id @default(cuid())
  familyId          String
  title             String
  description       String?
  assigneeId        String?
  dueAt             DateTime?
  recurrence        ChoreRecurrence @default(NONE)
  points            Int             @default(1)
  completedAt       DateTime?
  overdueNotifiedAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  family   Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assignee FamilyMember? @relation("ChoreAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([familyId, completedAt])
  @@index([assigneeId, completedAt])
  @@index([dueAt, completedAt])
}

model Reminder {
  id          String       @id @default(cuid())
  familyId    String
  memberId    String? // who the reminder is for (e.g. the child taking medicine)
  kind        ReminderKind
  title       String
  notes       String?
  // Medicine: dosage + daily "HH:mm" times in the family timezone.
  dosage      String?
  timesOfDay  String[]
  // School/general: one-off due time.
  remindAt    DateTime?
  active      Boolean      @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime     @default(now())

  family Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([familyId, active])
  @@index([remindAt, active])
}

model Document {
  id           String       @id @default(cuid())
  familyId     String
  name         String
  storageKey   String       @unique // R2 object key: {familyId}/{cuid}/{filename}
  mimeType     String
  sizeBytes    Int
  folder       String       @default("General") // Medical, School, Insurance, IDs, ...
  // Only these roles can see the file. Documents default to parents only.
  visibleTo    FamilyRole[] @default([ADMIN_PARENT, PARENT])
  uploadedById String
  createdAt    DateTime     @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, folder])
}

model EmergencyContact {
  id           String   @id @default(cuid())
  familyId     String
  name         String
  relationship String
  phone        String
  email        String?
  notes        String?
  priority     Int      @default(0)
  createdAt    DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, priority])
}

model Vacation {
  id          String   @id @default(cuid())
  familyId    String
  destination String
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  budget      Int?
  itinerary   Json? // AI or manually built day-by-day plan
  packingList Json? // [{ item, memberId?, packed }]
  createdAt   DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, startDate])
}

model AppointmentRequest {
  id              String            @id @default(cuid())
  familyId        String
  forMemberId     String?
  request         String // the parent's natural-language ask
  providerName    String?
  providerPhone   String?
  providerEmail   String?
  providerPlaceId String?
  draftSubject    String?
  draftMessage    String?
  candidates      Json? // providers Claude found
  status          AppointmentStatus @default(DRAFT)
  approvedById    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, status])
}

model Subscription {
  id                   String             @id @default(cuid())
  familyId             String             @unique
  tier                 PlanTier           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  source               BillingSource?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  updatedAt            DateTime           @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

// Per-family AI metering so free-tier families can be rate limited and costs tracked.
model AiUsage {
  id              String   @id @default(cuid())
  familyId        String
  feature         String // dinner | weekend | appointment
  inputTokens     Int
  outputTokens    Int
  cacheReadTokens Int      @default(0)
  createdAt       DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
}

// Idempotency for Stripe / RevenueCat / Clerk webhooks.
model WebhookEvent {
  id         String   @id // provider event id
  provider   String
  receivedAt DateTime @default(now())
}
