{
  "name": "@flos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": "./src/router.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file=../../.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@clerk/fastify": "^3.1.82",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@flos/db": "workspace:*",
    "@flos/types": "workspace:*",
    "@flos/ui": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^11.0.0",
    "@trpc/server": "^11.19.0",
    "bullmq": "^6.3.9",
    "expo-server-sdk": "^7.2.0",
    "fastify": "^5.12.5",
    "ioredis": "^5.8.0",
    "pino": "^10.3.1",
    "posthog-node": "^5.54.1",
    "stripe": "^22.6.2",
    "superjson": "^2.2.6",
    "svix": "^1.76.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
